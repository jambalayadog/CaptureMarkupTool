{
  "name": "capture-markup-tool",
  "productName": "Capture Markup Tool",
  "version": "0.1.0",
  "description": "Capture Markup Tool: a layered screenshot and image markup editor (annotations, pixel art, photo basics).",
  "main": "./out/main/index.js",
  "author": "jwatt",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win",
    "postinstall": "node node_modules/electron/install.js"
  },
  "build": {
    "appId": "com.jwatt.capturemarkuptool",
    "productName": "Capture Markup Tool",
    "executableName": "CaptureMarkupTool",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "fileAssociations": [
      {
        "ext": "imk",
        "name": "Capture Markup Tool Project",
        "description": "Capture Markup Tool layered project"
      }
    ]
  },
  "dependencies": {
    "koffi": "^3.3.2",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
